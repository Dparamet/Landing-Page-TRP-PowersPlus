# ---------------------------------------------------------------------------
# TRP Powers Plus — ตัวอย่างค่า environment
# ก็อปไฟล์นี้เป็น .env.local แล้วเติมค่าจริงของคุณเอง (.env.local ถูก gitignore ไว้)
#   cp .env.example .env.local          (macOS/Linux)
#   Copy-Item .env.example .env.local   (Windows PowerShell)
# ---------------------------------------------------------------------------

# URL ของ Supabase project
#   หาได้ที่: Supabase Dashboard > Project Settings > API > Project URL
#   - ใช้ production/staging:  https://xxxxxxxx.supabase.co
#   - ใช้ local (supabase start): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (ปลอดภัยที่จะอยู่ฝั่ง client — สิทธิ์จริงคุมด้วย RLS)
#   หาได้ที่: Supabase Dashboard > Project Settings > API > Project API keys > anon public
#   ⚠️ ห้ามใส่ service_role key ที่นี่เด็ดขาด
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
